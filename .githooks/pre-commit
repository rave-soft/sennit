#!/usr/bin/env bash
# Pre-commit checks mirroring the fast half of CI (lint.yml + build.yml).
# The full -race test suite is too slow for a hook; run it before pushing:
#   go test -race -failfast ./...
# Install: git config core.hooksPath .githooks
# Bypass for a WIP commit: git commit --no-verify
set -euo pipefail

fail() {
	echo "pre-commit: $1" >&2
	exit 1
}

# 1. gofmt on staged Go files only.
staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' || true)
if [[ -n "$staged_go" ]]; then
	unformatted=$(gofmt -l $staged_go)
	[[ -z "$unformatted" ]] || fail "gofmt required: $unformatted"
fi

# 2. go.mod/go.sum tidy drift (CI: go mod tidy && git diff --exit-code).
go mod tidy
git diff --exit-code --quiet go.mod go.sum ||
	fail "go mod tidy changed go.mod/go.sum — stage the result"

# 3. Build.
go build ./... || fail "go build failed"

# 4. Lint (cached between runs; CI uses the same config).
#
# A failure is retried once against a cleaned cache before it blocks the
# commit. golangci-lint's cache outlives the tree it was populated from,
# and a stale entry gets replayed as a finding for code that is not in
# this commit — including files outside it entirely, reported with paths
# like ../../../internal/... when several worktrees live under
# .claude/worktrees/. Those phantoms vanish on a clean cache while a real
# finding survives it, so the retry tells them apart instead of leaving
# the author to guess and reach for --no-verify.
if command -v golangci-lint >/dev/null 2>&1; then
	if ! golangci-lint run --timeout 10m; then
		echo "pre-commit: lint failed; retrying against a clean cache" >&2
		golangci-lint cache clean || true
		golangci-lint run --timeout 10m || fail "golangci-lint found issues"
	fi
else
	echo "pre-commit: golangci-lint not installed, skipping lint" >&2
fi
